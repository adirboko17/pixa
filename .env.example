# העתק קובץ זה ל-.env.local והכנס את המפתח שלך
# Copy this file to .env.local and put your OpenAI API key here

OPENAI_API_KEY=sk-your-openai-key-here

# אופציונלי: מספר מקסימלי של בקשות במקביל לשרת OpenAI (ברירת מחדל 3)
# Optional: max parallel requests to OpenAI (default 3)
MAX_CONCURRENCY=3

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_key

# Optional, server-only — never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=
